    "Spaceroom": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaceroom"
          }
        }
      }
    },
    "Spaceroom can now see every cleanable location.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaceroom sekarang bisa melihat setiap lokasi yang bisa dibersihkan."
          }
        }
      }
    },
    "Spaceroom looks for data of apps that are no longer installed and haven't been touched for 30 days.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaceroom mencari data aplikasi yang sudah tidak terpasang dan tidak disentuh selama 30 hari."
          }
        }
      }
    },
    "Spaceroom never cleans, uninstalls or moves anything here, and scans show it as Ignored. A folder protects everything inside it.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaceroom tidak pernah membersihkan, menghapus instalan, atau memindahkan apa pun di sini, dan pemindaian menampilkannya sebagai Diabaikan. Folder melindungi semua isinya."
          }
        }
      }
    },
    "Spaceroom stops it now and moves its launch file to the Restore Center. Restoring it brings it back at your next login.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaceroom menghentikannya sekarang dan memindahkan file launch-nya ke Pusat Pemulihan. Memulihkannya akan menjalankannya lagi saat login berikutnya."
          }
        }
      }
    },
    "Spaceroom will never clean, uninstall or move what you choose.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Spaceroom tidak akan pernah membersihkan, menghapus instalan, atau memindahkan yang Anda pilih."
          }
        }
      }
    },
    "Start Using Spaceroom": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai Pakai Spaceroom"
          }
        }
      }
    },
